{
  "name": "flomo-web-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Third-party flomo command line tool based on flomo Web session credentials.",
  "license": "MIT",
  "keywords": [
    "flomo",
    "cli",
    "typescript",
    "notes"
  ],
  "bin": {
    "flomo-web": "./dist/index.js"
  },
  "files": [
    "dist",
    ".env.example",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "smoke": "node dist/index.js --help",
    "verify": "npm run smoke && npm audit --omit=dev --audit-level=moderate"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "zod": "^3.25.76"
  }
}
